; A work-item orders its own accesses to a read-write image with a fence on
; image memory at work-item scope, the only image fence OpenCL C has. It gets
; its own atomic_work_item_fence; the other memory the semantics name is fenced
; at the work-group, the narrowest scope atomic_work_item_fence otherwise takes.
; Likewise, a barrier fences image memory only at work-group scope, so one with
; a wider memory scope gets a separate barrier for it.
; (0x808 = 2056 is AcquireRelease | Image, 0xB90 = 2960 SequentiallyConsistent
; with Subgroup, Workgroup, CrossWorkgroup and Image memory.)
; RUN: %spirv2clc --asm --cl-std=CL2.0 %s | %FileCheck %s
; RUN: %spirv2clc --asm --cl-std=CL2.0 %s | %clang -c -cl-std=CL2.0 -x cl - -o /dev/null
               OpCapability Kernel
               OpCapability Addresses
               OpCapability ImageBasic
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %k "k"
       %void = OpTypeVoid
       %uint = OpTypeInt 32 0
        %img = OpTypeImage %void 2D 0 0 0 0 Unknown ReadWrite
 %invocation = OpConstant %uint 4
%acqrel_image = OpConstant %uint 2056
     %seqcst = OpConstant %uint 2960
     %device = OpConstant %uint 1
  %workgroup = OpConstant %uint 2
       %fnty = OpTypeFunction %void %img
          %k = OpFunction %void None %fnty
          %i = OpFunctionParameter %img
         %bb = OpLabel
               OpMemoryBarrier %invocation %acqrel_image
               OpMemoryBarrier %invocation %seqcst
               OpControlBarrier %workgroup %device %seqcst
               OpReturn
               OpFunctionEnd
; CHECK:      atomic_work_item_fence(CLK_IMAGE_MEM_FENCE, memory_order_acq_rel, memory_scope_work_item);
; CHECK-NEXT: atomic_work_item_fence(CLK_IMAGE_MEM_FENCE, memory_order_acq_rel, memory_scope_work_item);
; CHECK-NEXT: atomic_work_item_fence(CLK_LOCAL_MEM_FENCE | CLK_GLOBAL_MEM_FENCE, memory_order_seq_cst, memory_scope_work_group);
; CHECK-NEXT: barrier(CLK_IMAGE_MEM_FENCE);
; CHECK-NEXT: work_group_barrier(CLK_LOCAL_MEM_FENCE | CLK_GLOBAL_MEM_FENCE, memory_scope_device);
