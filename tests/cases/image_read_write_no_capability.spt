; The ReadWrite access qualifier only requires Kernel, so a module may use a
; read_write image without declaring ImageReadWrite. Below OpenCL C 2.0 the
; image type itself must then be refused.
; RUN: not %spirv2clc --asm --spirv-version=1.4 --cl-std=CL1.2 %s 2>&1 | %FileCheck %s
; RUN: %spirv2clc --asm --spirv-version=1.4 --cl-std=CL2.0 %s | %clang -c -cl-std=CL2.0 -x cl - -o /dev/null
               OpCapability Kernel
               OpCapability Addresses
               OpCapability ImageBasic
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %k "k"
       %void = OpTypeVoid
        %img = OpTypeImage %void 2D 0 0 0 0 Unknown ReadWrite
       %fnty = OpTypeFunction %void %img
          %k = OpFunction %void None %fnty
          %i = OpFunctionParameter %img
         %bb = OpLabel
               OpReturn
               OpFunctionEnd
; CHECK: read_write images require OpenCL C 2.0
