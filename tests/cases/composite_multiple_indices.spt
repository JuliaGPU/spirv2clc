; OpCompositeExtract/OpCompositeInsert with several indices select a member
; nested inside the composite (LLVM emits these for insertvalue/extractvalue
; with a multi-level index list, e.g. building a Julia struct that contains a
; tuple). Every index must be followed: struct member, then array element
; (struct-wrapped, through 'e'), then vector component.
; RUN: %spirv2clc --asm %s | %clang -c -cl-std=CL1.2 -x cl - -o /dev/null
; RUN: %spirv2clc --asm %s | %FileCheck %s
               OpCapability Kernel
               OpCapability Addresses
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %k "test"
       %void = OpTypeVoid
       %uint = OpTypeInt 32 0
     %uint_2 = OpConstant %uint 2
     %uint_7 = OpConstant %uint 7
      %v4int = OpTypeVector %uint 4
        %arr = OpTypeArray %v4int %uint_2
      %inner = OpTypeStruct %uint %arr
      %outer = OpTypeStruct %uint %inner
      %p_g_u = OpTypePointer CrossWorkgroup %uint
      %undef = OpUndef %outer
       %fnty = OpTypeFunction %void %p_g_u
          %k = OpFunction %void None %fnty
        %out = OpFunctionParameter %p_g_u
        %lbl = OpLabel
         %s1 = OpCompositeInsert %outer %uint_7 %undef 0
         %s2 = OpCompositeInsert %outer %uint_2 %s1 1 0
         %s3 = OpCompositeInsert %outer %uint_7 %s2 1 1 1 3
          %x = OpCompositeExtract %uint %s3 1 1 1 3
          %y = OpCompositeExtract %uint %s3 1 0
          %z = OpIAdd %uint %x %y
               OpStore %out %z
               OpReturn
               OpFunctionEnd
; CHECK: [[S1:v[0-9]+]].m0 = {{.*}};
; CHECK: [[S2:v[0-9]+]].m1.m0 = {{.*}};
; CHECK: [[S3:v[0-9]+]].m1.m1.e[1].s3 = {{.*}};
; CHECK: = [[S3]].m1.m1.e[1].s3;
; CHECK: = [[S3]].m1.m0;
