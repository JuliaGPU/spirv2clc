; CHECK-DAG: SMin_ClusteredReduce = (uint)sub_group_clustered_reduce_min(as_int(
; CHECK-DAG: UMin_Reduce = sub_group_non_uniform_reduce_min(
; CHECK-DAG: UMin_InclusiveScan = sub_group_non_uniform_scan_inclusive_min(
; CHECK-DAG: UMin_ExclusiveScan = sub_group_non_uniform_scan_exclusive_min(
; CHECK-DAG: UMin_ClusteredReduce = sub_group_clustered_reduce_min(
