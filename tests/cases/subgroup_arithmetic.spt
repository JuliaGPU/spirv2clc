; CHECK-DAG: SMax_ExclusiveScan = (uint)sub_group_non_uniform_scan_exclusive_max(as_int(
; CHECK-DAG: SMax_ClusteredReduce = (uint)sub_group_clustered_reduce_max(as_int(
; CHECK-DAG: UMax_Reduce = sub_group_non_uniform_reduce_max(
; CHECK-DAG: UMax_InclusiveScan = sub_group_non_uniform_scan_inclusive_max(
; CHECK-DAG: UMax_ExclusiveScan = sub_group_non_uniform_scan_exclusive_max(
