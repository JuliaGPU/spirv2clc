; Input that isn't a SPIR-V module is rejected, not translated or crashed on.
; RUN: not %spirv2clc --asm %s 2>&1 | %FileCheck %s --check-prefix=ASM
; ASM: Expected <opcode> or <result-id> at the beginning of an instruction, found 'bogus'
; ASM: Failed to translate module.
; RUN: echo -n abc > %t.spv
; RUN: not %spirv2clc %t.spv 2>&1 | %FileCheck %s --check-prefix=SIZE
; SIZE: is not a SPIR-V binary (its size is not a multiple of 4 bytes)
               OpCapability Kernel
               bogus
