; A subgroup Groups instruction enables cl_khr_subgroups on OpenCL C 2.0+.
; RUN: not %spirv2clc --asm --spirv-version=1.4 --cl-std=CL1.2 %s
; RUN: %spirv2clc --asm --spirv-version=1.4 --cl-std=CL3.0 %s | %FileCheck %s
               OpCapability Kernel
               OpCapability Addresses
               OpCapability Groups
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %main "test"
       %void = OpTypeVoid
       %bool = OpTypeBool
       %uint = OpTypeInt 32 0
      %scope = OpConstant %uint 3
       %true = OpConstantTrue %bool
     %mainty = OpTypeFunction %void
       %main = OpFunction %void None %mainty
        %mbb = OpLabel
        %any = OpGroupAny %bool %scope %true
               OpReturn
               OpFunctionEnd
; CHECK: #pragma OPENCL EXTENSION cl_khr_subgroups : enable
