; OpMemoryBarrier is a standalone fence; map it to atomic_work_item_fence with
; the CLK_*_MEM_FENCE flags derived from the memory semantics (the same mapping
; the OpControlBarrier fence uses), and the order and scope of the operands.
; OpenCL C 1.x's mem_fence only orders memory within a work-group, so this
; device-scope fence fails to translate there.
; RUN: not %spirv2clc --asm --cl-std=CL1.2 %s
; RUN: %spirv2clc --asm --cl-std=CL2.0 %s | %clang -c -cl-std=CL2.0 -x cl - -o /dev/null
; RUN: %spirv2clc --asm --cl-std=CL2.0 %s | %FileCheck %s
               OpCapability Kernel
               OpCapability Addresses
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %k "test"
       %void = OpTypeVoid
       %uint = OpTypeInt 32 0
        %dev = OpConstant %uint 1
        %sem = OpConstant %uint 784
       %fnty = OpTypeFunction %void
          %k = OpFunction %void None %fnty
        %lbl = OpLabel
               OpMemoryBarrier %dev %sem
               OpReturn
               OpFunctionEnd
; CHECK: atomic_work_item_fence(CLK_LOCAL_MEM_FENCE | CLK_GLOBAL_MEM_FENCE, memory_order_seq_cst, memory_scope_device)
